# Copiar este archivo como .env y completar los valores

# Cadena de conexión de PostgreSQL (Neon entrega una parecida a esta)
DATABASE_URL=postgresql://usuario:clave@host/aquachile?sslmode=require

# Clave para firmar los tokens de sesión (usar una distinta en producción)
JWT_SECRET=cambiar-esta-clave

PORT=3001
